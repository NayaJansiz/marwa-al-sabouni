---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Marwa Al-Sabouni — Architect & Author" description="The work and writing of Marwa Al-Sabouni.">
  <section class="hero">
    <div>
      <p class="eyebrow">Architect · Author · Researcher</p>
      <h1>Space, memory<br />and the human<br />experience.</h1>
      <p class="hero-copy">An independent practice exploring the relationship between architecture, people and place. A space for projects, writing and conversations.</p>
      <a class="hero-link" href="/about/">Discover Marwa <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="hero-visual">
      <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1500&q=85" alt="Quiet architectural interior with natural materials and light" />
      <figcaption class="hero-caption">Architecture · Place · Everyday life</figcaption>
    </figure>
  </section>
  <section class="intro-band">
    <h2>Architecture is never only about buildings.</h2>
    <p>This portfolio brings together selected projects, publications and public conversations. It is an evolving record of ideas, places and the people who shape them.</p>
  </section>
  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Selected work</p><h2>Projects</h2></div>
      <a href="/projects/">Explore all projects ↗</a>
    </div>
    <div class="project-grid">
      <a class="project-card" href="/projects/">
        <div class="project-image"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85" alt="Contemporary architectural space" loading="lazy" /></div>
        <div class="project-meta"><strong>Selected project</strong><span>Project archive</span></div>
      </a>
      <a class="project-card" href="/projects/">
        <div class="project-image"><img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1000&q=85" alt="Architectural detail and material study" loading="lazy" /></div>
        <div class="project-meta"><strong>Ideas in space</strong><span>Project archive</span></div>
      </a>
    </div>
  </section>
  <section class="editorial-strip">
    <div><p class="eyebrow">Beyond the built</p><h2>Books, ideas<br />&amp; conversations.</h2></div>
    <div><p>Explore publications, upcoming talks, interviews and reviews—bringing together the written and spoken work alongside the architectural practice.</p><a class="hero-link" href="/publications/">Explore publications <span aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>
