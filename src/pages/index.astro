---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Marwa Al-Sabouni — Architect & Author" description="Portfolio structure for the work, writing and public conversations of Marwa Al-Sabouni.">
  <section class="hero">
    <div>
      <p class="eyebrow">Architecture · Writing · Ideas</p>
      <h1>Space, memory<br />and the human<br />experience.</h1>
      <p class="hero-copy">A space for architectural work, writing and public conversations—bringing projects, publications and ideas together.</p>
      <a class="hero-link" href="/about/">Discover Marwa <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="hero-visual">
      <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1500&q=85" alt="Atmospheric architectural interior used as a temporary design image" />
      <figcaption class="hero-caption">Visual placeholder · Replace with approved image</figcaption>
    </figure>
  </section>
  <section class="intro-band">
    <h2>Architecture is never only about buildings.</h2>
    <p>This portfolio is being prepared to bring together selected projects, publications and public conversations. The final biography and verified materials will be added with Marwa's approval.</p>
  </section>
  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Portfolio archive</p><h2>Projects</h2></div>
      <a href="/projects/">Explore all projects ↗</a>
    </div>
    <div class="project-grid">
      <a class="project-card" href="/projects/">
        <div class="project-image"><img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85" alt="Temporary architectural image, not a confirmed project by Marwa" loading="lazy" /></div>
        <div class="project-meta"><strong>Layout preview</strong><span>Temporary image</span></div>
      </a>
      <a class="project-card" href="/projects/">
        <div class="project-image"><img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1000&q=85" alt="Temporary architectural detail image, not a confirmed project by Marwa" loading="lazy" /></div>
        <div class="project-meta"><strong>Layout preview</strong><span>Temporary image</span></div>
      </a>
    </div>
  </section>
  <section class="editorial-strip">
    <div><p class="eyebrow">Beyond the built</p><h2>Books, ideas<br />&amp; conversations.</h2></div>
    <div><p>Explore the planned sections for books, articles, upcoming talks, interviews and reviews. Verified content will be added through the content management system.</p><a class="hero-link" href="/publications/">Explore publications <span aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>
